<?xml version="1.0" encoding="utf-8"?>
<!-- TLS only: cleartext HTTP is forbidden everywhere; only system CAs are trusted. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>
