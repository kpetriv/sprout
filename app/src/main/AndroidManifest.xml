<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools">

  <!-- Sync with Firebase (M3). Each permission is added with the feature that needs it. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- WorkManager's network constraint (sync, M3) and Firestore/Firebase Auth connectivity checks; also declared by
       those libraries. It no longer comes with ML Kit's uploader, which is removed below (D-M6-33). -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- On-device AI (M6, ADR-0010): binding to Android's AICore system service that runs Gemini Nano. Also declared by
       com.google.mlkit:genai-prompt. Inference runs on the phone. -->
  <uses-permission android:name="com.google.android.apps.aicore.service.BIND_SERVICE" />

  <application
    android:name=".SproutApplication"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:enableOnBackInvokedCallback="true"
    android:fullBackupContent="@xml/backup_rules"
    android:icon="@mipmap/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:roundIcon="@mipmap/ic_launcher"
    android:supportsRtl="true"
    android:theme="@style/Theme.Sprout"
    tools:targetApi="33">

    <!-- No <profileable> here: the androidx.baselineprofile plugin adds it to the benchmark variants only. -->

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:windowSoftInputMode="adjustResize">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- WorkManager is initialised on demand through SproutApplication (Configuration.Provider), so Hilt can inject
         the workers; remove its androidx.startup initializer and keep the others (lifecycle-process, profileinstaller). -->
    <provider
      android:name="androidx.startup.InitializationProvider"
      android:authorities="${applicationId}.androidx-startup"
      android:exported="false"
      tools:node="merge">
      <meta-data
        android:name="androidx.work.WorkManagerInitializer"
        android:value="androidx.startup"
        tools:node="remove" />
    </provider>

    <!-- D-M6-33 (audit H1): ML Kit bundles Google's usage-metrics uploader (datatransport/Firelog over CCT). Removing
         its only network backend means the SDKs' own metrics never leave the app; :app:checkMergedManifestForTelemetry
         fails the build if any datatransport backend comes back (a new dependency, or a future Crashlytics, would need
         a decision first). Receipt text recognition still reports one usage event per scan through Google Play
         services, which this cannot remove (D-M6-51). The class is on the runtime classpath only (through core/ai),
         hence MissingClass. -->
    <service
      android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
      tools:ignore="MissingClass"
      tools:node="merge">
      <meta-data
        android:name="backend:com.google.android.datatransport.cct.CctBackendFactory"
        tools:node="remove" />
    </service>
  </application>

</manifest>
