<?xml version="1.0" encoding="utf-8"?>
<!-- The Sprout widget (M7 §4): 2×2 by default, resizable to 4×2 and larger. No updatePeriodMillis: the app refreshes it
     (WidgetRefresher: after a sync, local ledger and chore writes, a time bank stop, and a 6 h WorkManager fallback). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
  android:description="@string/widget_description"
  android:initialLayout="@layout/glance_default_loading_layout"
  android:minWidth="110dp"
  android:minHeight="110dp"
  android:minResizeWidth="110dp"
  android:minResizeHeight="110dp"
  android:previewImage="@drawable/sprout_widget_preview"
  android:previewLayout="@layout/sprout_widget_preview"
  android:resizeMode="horizontal|vertical"
  android:targetCellWidth="2"
  android:targetCellHeight="2"
  android:updatePeriodMillis="0"
  android:widgetCategory="home_screen" />
