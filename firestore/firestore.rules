rules_version = '2';

// Sprout Firestore security rules (docs/milestones/M3.md §5 and §7, docs/FIREBASE.md "Document shapes").
//
// Trust model:
// - Household membership and role come from households/{hid}/members/{uid}, written by Cloud Functions only. Rules
//   never trust a role, uid or household claimed inside client data.
// - Every client write names its author: authorUid must be the caller and authorDeviceId an ACTIVE device registered
//   to the caller in households/{hid}/devices (also written by Cloud Functions only).
// - A member whose row carries tokensValidAfter (set by revokeDevice when a parent device is revoked) writes only
//   with an ID token whose auth_time is not older than it: sessions signed in before the revocation are refused.
// - Ledger events are create-only. Documents (one collection per docType) follow the client ConflictResolver
//   (core/sync): a tombstone (deleted == true) is never overwritten by a live copy and a parent may tombstone a live
//   document whatever its lamport; two live chore submissions compare status rank first (APPROVED > REJECTED >
//   SUBMITTED); everything else is last-writer-wins on (lamport, authorDeviceId). Deletion is a tombstone document,
//   never a Firestore delete.
// - parentKeys are written by Cloud Functions only (registerParentKey, revokeDevice).
// - Top-level collections (linkCodes, challenges, deletionRecords, rateLimits, userHouseholds) and anything not
//   matched below are closed to clients: there is no rule granting access, so the default deny applies.
//
// Size limits: rules cannot measure a document's byte size. Events (target <= 16 KB) are bounded by a closed key
// set, a length bound on every scalar string and on causedBy (at most 16 ids of at most 128 characters). Documents
// (target payload <= 64 KB) are bounded by a closed top-level key set, string bounds on the envelope fields and a
// closed payload key set per docType (the Kotlin models' serial names) with a bound on every string and list; the
// values of nested maps (schedule, reward, cadence, photoRef) are bounded by key count only. Firestore's own 1 MiB
// document limit is the hard ceiling in both cases.
//
// Evaluation budget: a request may evaluate at most 1,000 expressions. The write rules therefore read the caller's
// member row and the author device once and pass them down (m, d) instead of calling get() helpers repeatedly; a
// write that runs over the budget is denied, so a new check on a hot path needs a test with a worst-case payload.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isHex64(s) {
      return s is string && s.matches('^[0-9a-f]{64}$');
    }

    function boundedString(s, max) {
      return s is string && s.size() > 0 && s.size() <= max;
    }

    // Optional field k of map m: absent, null, or a string of at most max characters.
    function optString(m, k, max) {
      return m.get(k, null) == null || (m[k] is string && m[k].size() <= max);
    }

    // Optional field k of map m: absent, null, or an integer.
    function optInt(m, k) {
      return m.get(k, null) == null || m[k] is int;
    }

    // Optional field k of map m: absent, null, or a bool.
    function optBool(m, k) {
      return m.get(k, null) == null || m[k] is bool;
    }

    // Optional field k of map m: absent, null, or a map of at most maxKeys keys.
    function optMap(m, k, maxKeys) {
      return m.get(k, null) == null || (m[k] is map && m[k].size() <= maxKeys);
    }

    // Optional field k of map m: absent, null, or a list of at most maxSize elements.
    function optList(m, k, maxSize) {
      return m.get(k, null) == null || (m[k] is list && m[k].size() <= maxSize);
    }

    // 1 to 16 ids, each 1 to 128 characters of the id alphabet [A-Za-z0-9._-] (event ids are UUIDs). Rules have no
    // loops, so the list is checked through its comma-joined form: the alphabet has no comma, so the regex sees
    // exactly the elements, and splitting the joined string must give the list back (join turns a number into its
    // digits, which the equality then rejects).
    function idList16(l) {
      return l is list && l.size() <= 16 && joinedIds(l.join(','), l);
    }

    function joinedIds(s, l) {
      return s.matches('^[A-Za-z0-9._-]{1,128}(,[A-Za-z0-9._-]{1,128}){0,15}$') && s.split(',') == l;
    }

    // Every client write stamps serverReceivedAt (FieldValue.serverTimestamp()) for pull cursors: required, and it
    // must be the server time.
    function serverStamp(m) {
      return 'serverReceivedAt' in m && m.serverReceivedAt == request.time;
    }

    // docType of each document collection.
    function docTypes() {
      return {
        'kids': 'kid',
        'accounts': 'account',
        'householdPolicy': 'household_policy',
        'chores': 'chore',
        'choreSubmissions': 'chore_submission',
        'rewards': 'reward',
        'allowanceSchedules': 'allowance_schedule',
        'savingsGoals': 'savings_goal',
        'interestPolicy': 'interest_policy'
      };
    }

    match /households/{hid} {

      function memberPath() {
        return /databases/$(database)/documents/households/$(hid)/members/$(request.auth.uid);
      }

      // The caller's member row. Reading it for a non-member fails the evaluation, which denies the request.
      function member() {
        return get(memberPath());
      }

      function isMember() {
        return signedIn() && exists(memberPath());
      }

      function devicePath(id) {
        return /databases/$(database)/documents/households/$(hid)/devices/$(id);
      }

      // The caller's session is not older than the member's tokensValidAfter (epoch seconds), which revokeDevice sets
      // when it revokes one of the member's parent devices; auth_time is the sign-in time, kept across token refresh.
      function sessionIsFresh(m) {
        return !('tokensValidAfter' in m) || request.auth.token.auth_time >= m.tokensValidAfter;
      }

      // d (a device row) is registered to the caller, ACTIVE (not PENDING, REVOKED), and the caller's session (member
      // row m) postdates any revocation of the caller's devices.
      function activeForCaller(d, m) {
        return d.uid == request.auth.uid && d.status == 'ACTIVE' && sessionIsFresh(m);
      }

      // id is a registered ACTIVE device of the caller (an unregistered id fails the get, which denies).
      function deviceIsActiveForCaller(id, m) {
        return isHex64(id) && activeForCaller(get(devicePath(id)).data, m);
      }

      // The household root document: written by functions only.
      allow read: if isMember();
      allow write: if false;

      // Membership mirrors the custom claims; written by functions only. A member reads only their own row.
      match /members/{uid} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, write: if false;
      }

      // Device registry; written by functions only.
      match /devices/{deviceId} {
        allow read: if isMember();
        allow write: if false;
      }

      // Parent authorisation keys: written by functions only (registerParentKey creates, revokeDevice stamps
      // revokedAtLamport). Readable by members, who verify parent signatures against them.
      match /parentKeys/{fingerprint} {
        allow read: if isMember();
        allow create, update, delete: if false;
      }

      // Ledger events: append-only. Doc id is eventId, or eventId__hash for a conflicting copy kept as evidence; only a
      // PARENT member stores such a copy (a kid creates events/{eventId} only).
      match /events/{eventDocId} {
        // e: the event; m: the caller's member row.
        function validEvent(e, m) {
          return e.keys().hasAll(['schemaVersion', 'eventId', 'householdId', 'kidId', 'accountId', 'authorUid',
                                  'authorRole', 'authorDeviceId', 'createdAt', 'lamport', 'prevHash', 'hash',
                                  'signature', 'type', 'serverReceivedAt'])
            && e.keys().hasOnly([
                 // Envelope (core/domain-ledger Envelope), flattened to the top level.
                 'schemaVersion', 'eventId', 'householdId', 'kidId', 'accountId', 'authorUid', 'authorRole',
                 'authorDeviceId', 'createdAt', 'lamport', 'prevHash', 'hash', 'signature', 'parentSignature',
                 // Polymorphic discriminator and the event-specific fields of every LedgerEvent type (schema 1-2).
                 'type', 'currency', 'amount', 'choreId', 'dueOn', 'scheduleId', 'periodKey', 'gameId', 'score',
                 'playedOn', 'rewardId', 'minutesGranted', 'reason', 'toAccountId', 'principal',
                 'annualRateBasisPoints', 'days', 'sessionId', 'minutesUsed', 'minutes', 'grantedBy', 'causedBy',
                 'note',
                 // Pull cursor.
                 'serverReceivedAt'])
            && e.schemaVersion in [1, 2]
            && boundedString(e.eventId, 128)
            && (eventDocId == e.eventId || (m.role == 'PARENT' && eventDocId == e.eventId + '__' + e.hash))
            && e.householdId == hid
            && boundedString(e.kidId, 128)
            && boundedString(e.accountId, 256)
            && e.authorUid == request.auth.uid
            && deviceIsActiveForCaller(e.authorDeviceId, m)
            && e.createdAt is int
            && e.lamport is int && e.lamport >= 0
            && (e.prevHash == null || isHex64(e.prevHash))
            && isHex64(e.hash)
            && boundedString(e.signature, 200)
            && optString(e, 'parentSignature', 200)
            && boundedString(e.type, 64)
            // A KID-role event may come from any member (kid mode on a parent device); a PARENT-role event only from
            // a PARENT member. A KID member writes only for their own kid.
            && (e.authorRole == 'KID' || (e.authorRole == 'PARENT' && m.role == 'PARENT'))
            && (m.role == 'PARENT' || (e.authorRole == 'KID' && e.kidId == m.kidId))
            // Event-specific scalar bounds.
            && optString(e, 'currency', 32) && optInt(e, 'amount')
            && optString(e, 'choreId', 128) && optString(e, 'dueOn', 32)
            && optString(e, 'scheduleId', 128) && optString(e, 'periodKey', 64)
            && optString(e, 'gameId', 128) && optInt(e, 'score') && optString(e, 'playedOn', 32)
            && optString(e, 'rewardId', 128) && optInt(e, 'minutesGranted')
            && optString(e, 'reason', 500) && optString(e, 'note', 500)
            && optString(e, 'toAccountId', 256) && optInt(e, 'principal')
            && optInt(e, 'annualRateBasisPoints') && optInt(e, 'days')
            && optString(e, 'sessionId', 128) && optInt(e, 'minutesUsed') && optInt(e, 'minutes')
            && optString(e, 'grantedBy', 128)
            && (e.get('causedBy', null) == null || idList16(e.causedBy))
            && serverStamp(e);
        }

        allow read: if isMember();
        allow create: if signedIn() && validEvent(request.resource.data, member().data);
        allow update, delete: if false;
      }

      // Signed documents (core/sync DocumentEnvelope), one collection per docType.
      match /{coll}/{docId} {
        function isDocCollection() {
          return coll in docTypes();
        }

        // Payload key sets are the serial names of the Kotlin models (core/model Kid, ChoreSubmission,
        // InterestPolicy; core/domain-ledger Account; core/domain-household Chore, Reward, AllowanceSchedule,
        // SavingsGoal; core/database DocumentPayloads for household_policy). Every key is optional (absent or null)
        // because the receivers validate the model; the rules bound kinds and sizes. Ids are at most 128 characters,
        // titles 80, a kid's first name 40, free text (description, note, rejectionReason) 500.
        function kidPayload(p) {
          return p.keys().hasOnly(['id', 'householdId', 'firstName', 'avatarId', 'birthYearMonth', 'uiTier',
                                   'archived'])
            && optString(p, 'id', 128) && optString(p, 'householdId', 128) && optString(p, 'firstName', 40)
            && optString(p, 'avatarId', 128) && optString(p, 'birthYearMonth', 16) && optString(p, 'uiTier', 32)
            && optBool(p, 'archived');
        }

        function accountPayload(p) {
          return p.keys().hasOnly(['id', 'kidId', 'currency', 'kind'])
            && optString(p, 'id', 128) && optString(p, 'kidId', 128) && optString(p, 'currency', 32)
            && optString(p, 'kind', 32);
        }

        function householdPolicyPayload(p) {
          return p.keys().hasOnly(['fiatCurrency', 'requireParentSignature'])
            && optString(p, 'fiatCurrency', 32) && optBool(p, 'requireParentSignature');
        }

        function chorePayload(p) {
          return p.keys().hasOnly(['id', 'householdId', 'kidId', 'title', 'description', 'reward', 'schedule',
                                   'createdAt', 'state'])
            && optString(p, 'id', 128) && optString(p, 'householdId', 128) && optString(p, 'kidId', 128)
            && optString(p, 'title', 80) && optString(p, 'description', 500)
            && optMap(p, 'reward', 2) && optMap(p, 'schedule', 2) && optString(p, 'createdAt', 64)
            && optString(p, 'state', 32)
            && (p.get('schedule', null) == null || optList(p.schedule, 'daysOfWeek', 7));
        }

        function submissionPayload(p) {
          return p.keys().hasOnly(['id', 'choreId', 'dueOn', 'kidId', 'submittedAt', 'note', 'photoRef', 'status',
                                   'decidedAt', 'decidedBy', 'rejectionReason'])
            && optString(p, 'id', 128) && optString(p, 'choreId', 128) && optString(p, 'dueOn', 32)
            && optString(p, 'kidId', 128) && optString(p, 'submittedAt', 64) && optString(p, 'note', 500)
            && p.get('status', null) in ['SUBMITTED', 'REJECTED', 'APPROVED']
            && optString(p, 'decidedAt', 64) && optString(p, 'decidedBy', 128)
            && optString(p, 'rejectionReason', 500)
            && (p.get('photoRef', null) == null
                || (p.photoRef is map && p.photoRef.keys().hasOnly(['fileName', 'sha256'])
                    && optString(p.photoRef, 'fileName', 128) && optString(p.photoRef, 'sha256', 64)));
        }

        function rewardPayload(p) {
          return p.keys().hasOnly(['id', 'householdId', 'title', 'kind', 'cost', 'currency', 'minutesGranted',
                                   'active', 'forKids'])
            && optString(p, 'id', 128) && optString(p, 'householdId', 128) && optString(p, 'title', 80)
            && optString(p, 'kind', 32) && optInt(p, 'cost') && optString(p, 'currency', 32)
            && optInt(p, 'minutesGranted') && optBool(p, 'active') && optList(p, 'forKids', 64);
        }

        function allowancePayload(p) {
          return p.keys().hasOnly(['id', 'kidId', 'accountId', 'amount', 'currency', 'cadence', 'startsOn',
                                   'active'])
            && optString(p, 'id', 128) && optString(p, 'kidId', 128) && optString(p, 'accountId', 128)
            && optInt(p, 'amount') && optString(p, 'currency', 32) && optMap(p, 'cadence', 2)
            && optString(p, 'startsOn', 32) && optBool(p, 'active');
        }

        function savingsGoalPayload(p) {
          return p.keys().hasOnly(['id', 'kidId', 'title', 'target', 'createdOn', 'achievedOn'])
            && optString(p, 'id', 128) && optString(p, 'kidId', 128) && optString(p, 'title', 80)
            && optInt(p, 'target') && optString(p, 'createdOn', 32) && optString(p, 'achievedOn', 32);
        }

        function interestPolicyPayload(p) {
          return p.keys().hasOnly(['householdId', 'annualRateBasisPoints', 'accrualDay'])
            && optString(p, 'householdId', 128) && optInt(p, 'annualRateBasisPoints') && optInt(p, 'accrualDay');
        }

        function validPayload(p) {
          return p is map && (
            coll == 'choreSubmissions' ? submissionPayload(p)
            : coll == 'chores' ? chorePayload(p)
            : coll == 'rewards' ? rewardPayload(p)
            : coll == 'kids' ? kidPayload(p)
            : coll == 'accounts' ? accountPayload(p)
            : coll == 'householdPolicy' ? householdPolicyPayload(p)
            : coll == 'allowanceSchedules' ? allowancePayload(p)
            : coll == 'savingsGoals' ? savingsGoalPayload(p)
            : coll == 'interestPolicy' && interestPolicyPayload(p));
        }

        // d: the written envelope; m: the caller's member row. Every top-level key is required.
        function validDocument(d, m) {
          return d.keys().size() == 11
            && d.keys().hasOnly(['schemaVersion', 'householdId', 'docType', 'docId', 'authorUid', 'authorDeviceId',
                                 'lamport', 'deleted', 'payload', 'signature', 'serverReceivedAt'])
            && d.schemaVersion == 1
            && d.householdId == hid
            && d.docType == docTypes()[coll]
            && d.docId == docId
            && boundedString(d.docId, 256)
            && d.authorUid == request.auth.uid
            && deviceIsActiveForCaller(d.authorDeviceId, m)
            && d.lamport is int && d.lamport >= 0
            && d.deleted is bool
            && validPayload(d.payload)
            && boundedString(d.signature, 200)
            && serverStamp(d);
        }

        // Last writer wins on (lamport, authorDeviceId): strictly newer, or same lamport and a greater device id.
        function newerThan(n, o) {
          return n.lamport > o.lamport || (n.lamport == o.lamport && n.authorDeviceId > o.authorDeviceId);
        }

        // SubmissionStatusPrecedence.rank: APPROVED > REJECTED > SUBMITTED; anything else ranks below them.
        function statusRank(p) {
          return {'SUBMITTED': 0, 'REJECTED': 1, 'APPROVED': 2}.get(p.get('status', ''), -1);
        }

        // n (written) wins over o (stored) under core/sync ConflictResolver's order:
        // 1. a live copy never replaces a tombstone; a PARENT may tombstone a live document whatever the lamports;
        // 2. between two live chore submissions of different status rank, the higher rank wins whatever the lamports;
        // 3. otherwise last writer wins.
        function winsConflict(n, o, m) {
          return (o.deleted == false || n.deleted == true)
            && ((m.role == 'PARENT' && n.deleted == true && o.deleted == false)
                || (coll == 'choreSubmissions' && n.deleted == false && o.deleted == false
                    ? rankWins(statusRank(n.payload), statusRank(o.payload), n, o)
                    : newerThan(n, o)));
        }

        function rankWins(nr, sr, n, o) {
          return nr > sr || (nr == sr && newerThan(n, o));
        }

        // A KID member (kid k) writes only undecided submissions for their own kid under the submission's own id
        // (core/sync DocTypes.kidMayWrite), never tombstones; on update only over a live, undecided submission of
        // their own kid whose identity (id, choreId, dueOn, kidId) stays the same (o: the stored copy, or null).
        function kidMayWrite(n, k, o) {
          let p = n.payload;
          return coll == 'choreSubmissions'
            && n.deleted == false
            && p.kidId == k
            && p.status == 'SUBMITTED'
            && p.id == docId
            && (o == null || kidMayOverwrite(p, k, o));
        }

        function kidMayOverwrite(p, k, o) {
          let op = o.payload;
          return o.deleted == false
            && op.get('kidId', null) == k
            && op.get('status', null) == 'SUBMITTED'
            && p.get('id', null) == op.get('id', null)
            && p.get('choreId', null) == op.get('choreId', null)
            && p.get('dueOn', null) == op.get('dueOn', null);
        }

        // n: written envelope; m: caller's member row; o: stored envelope on update, null on create.
        function mayWrite(n, m, o) {
          return validDocument(n, m)
            && (o == null || winsConflict(n, o, m))
            && (m.role == 'PARENT' || (m.role == 'KID' && kidMayWrite(n, m.kidId, o)));
        }

        allow read: if isDocCollection() && isMember();
        allow create: if isDocCollection() && signedIn() && mayWrite(request.resource.data, member().data, null);
        allow update: if isDocCollection() && signedIn()
                      && mayWrite(request.resource.data, member().data, resource.data);
        allow delete: if false;
      }
    }
  }
}
